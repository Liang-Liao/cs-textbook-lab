/* NFA (Thompson 构造) */
digraph "NFA" {
  rankdir=LR;
  node [shape=circle];
  "0" [shape=doublecircle];
  0 -> 2 [label="ε"];
  0 -> 1 [label="ε"];
  1 -> 8 [label="ε"];
  2 -> 4 [label="ε"];
  2 -> 6 [label="ε"];
  3 -> 2 [label="ε"];
  3 -> 1 [label="ε"];
  4 -> 5 [label="'a'"];
  5 -> 3 [label="ε"];
  6 -> 7 [label="'b'"];
  7 -> 3 [label="ε"];
  8 -> 9 [label="'a'"];
  9 -> 10 [label="ε"];
  10 -> 11 [label="'b'"];
  11 -> 12 [label="ε"];
  12 -> 13 [label="'b'"];
  13 [shape=doublecircle];
}

/* 最小化 DFA */
digraph "minDFA" {
  rankdir=LR;
  node [shape=circle];
  start [shape=point];
  start -> 0;
  0 -> 1 [label="a"];
  0 -> 0 [label="b"];
  1 -> 1 [label="a"];
  1 -> 2 [label="b"];
  2 -> 1 [label="a"];
  2 -> 3 [label="b"];
  3 [shape=doublecircle,label="3/规则1"];
  3 -> 1 [label="a"];
  3 -> 0 [label="b"];
}
