// MiniC v2 测试程序：覆盖所有优先级层、结合性、类型提升
// 乘除模优先级
print 3 + 4 * 2;          // 11
print (1 + 2) * 3;        // 9
// 左结合验证（右结合会得到 9）
print 10 - 3 - 2;         // 5
print 8 / 4 / 2;          // 1
// 整数与浮点混合：提升为浮点
print 7 / 2;              // 3   (int/int 截断)
print 7 / 2.0;            // 3.5 (提升)
print 3.5 * 2;            // 7
// 取模
print 10 % 3;             // 1
print 2 + 3 * 4 % 5;      // 4   (3*4=12, 12%5=2, 2+2=4)
// 关系与相等（结果 0/1）
print 1 < 2;              // 1
print 2 <= 1;             // 0
print 3 > 2 >= 2;         // 0   左结合: (3>2)=1, 1>=2=0
print 1 == 1;             // 1
print 1 != 2;             // 1
// 关系低于加减
print 1 + 1 == 2;         // 1
// 一元负号
print -3 + 5;             // 2
print 2 * -3;             // -6
print -(2 + 3);           // -5
print --5;                // 5   (负负得正)
// 嵌套括号
print ((1 + 2) * (3 + 4)); // 21
// 裸表达式语句（值被丢弃，不打印）
1 + 1;
// 空行和注释都应被忽略
