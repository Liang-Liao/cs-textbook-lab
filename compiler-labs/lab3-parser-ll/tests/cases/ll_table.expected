产生式表:
  P0  stmt_list -> stmt stmt_list
  P1  stmt_list -> ε
  P2  stmt -> KW_PRINT expr SEMI
  P3  stmt -> expr SEMI
  P4  expr -> equality
  P5  equality -> rel equality'
  P6  equality' -> EQ rel equality'
  P7  equality' -> NEQ rel equality'
  P8  equality' -> ε
  P9  rel -> add rel'
  P10 rel' -> LT add rel'
  P11 rel' -> LE add rel'
  P12 rel' -> GT add rel'
  P13 rel' -> GE add rel'
  P14 rel' -> ε
  P15 add -> term add'
  P16 add' -> PLUS term add'
  P17 add' -> MINUS term add'
  P18 add' -> ε
  P19 term -> factor term'
  P20 term' -> STAR factor term'
  P21 term' -> SLASH factor term'
  P22 term' -> PERCENT factor term'
  P23 term' -> ε
  P24 factor -> LPAREN expr RPAREN
  P25 factor -> MINUS factor
  P26 factor -> INT_LIT
  P27 factor -> FLOAT_LIT
