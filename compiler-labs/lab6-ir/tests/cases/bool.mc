// 短路布尔测试：右操作数被跳过 / 求值 / 优先级（|| < && < ==，同 C）
// 短路硬证据：右边是 1/0，左边能短路就绝不崩；左边短路不了才崩（不放本文件）
print 0 && 1 / 0;        // 0   右边除零被跳过
print 1 || 1 / 0;        // 1   右边除零被跳过
print 1 && 1 / 1;        // 1   左真 → 右边照常求值
// ! 与短路混用
print !0 && 1;           // 1
print !1 || 0;           // 0
print !!5;               // 1
// 优先级：&& 高于 ||（若同级左结合，第二行会得 1）
print 1 || 0 && 0;       // 1   = 1 || (0 && 0)
print (1 || 0) && 0;     // 0   括号强制先 ||
// 值上下文与跳转上下文产出相同语义（菱形定值 vs 直接跳转）
int a = 0;
int b = 1;
print a && b;            // 0
print a || b;            // 1
print b && a;            // 0
print b || a;            // 1
// 比较参与短路（比较直跳 + 回填链合并）
print 2 > 1 && 3 > 2;    // 1
print 2 < 1 && 1 / 0;    // 0   左比较假 → 右边跳过
print 2 < 1 || 2;        // 1   左假 → 右边求值
// 短路当 if/while 条件（跳转上下文）
if (0 && 1 / 0) print 111; else print 222;   // 222
int i = 0;
while (i < 3 && 1) i = i + 1;
print i;                 // 3
